{
	"name": "giselle-project",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "turbo build",
		"build-sdk": "turbo build --filter '@giselles-ai/*'",
		"build-data-type": "turbo build --filter '@giselles-ai/protocol'",
		"check-types": "turbo check-types",
		"format": "biome check --write .",
		"clean": "turbo clean",
		"dev:studio.giselles.ai": "NODE_NO_WARNINGS=1 turbo dev --filter studio.giselles.ai",
		"test": "turbo test",
		"tidy": "knip --no-config-hints",
		"strip-workspace": "pnpm -F strip-workspace strip-workspace",
		"prevd": "pnpm i && pnpm build-sdk",
		"vd": "vercel dev",
		"report:colors": "node scripts/report-colors.mjs",
		"report:colors:out": "node scripts/report-colors.mjs --out .reports/report-colors.json",
		"guard:colors": "node scripts/guard-colors.mjs",
		"lint:colors:code": "node scripts/lint-colors-code.mjs",
		"metrics:count": "node scripts/metrics-count.mjs",
		"codemod:text-black-600-20": "node scripts/codemods/replace-text-black-600-20.mjs",
		"codemod:text-black-600-20:apply": "node scripts/codemods/replace-text-black-600-20.mjs --apply",
		"codemod:text-white-900": "node scripts/codemods/replace-text-white-900-to-inverse.mjs",
		"codemod:text-white-900:apply": "node scripts/codemods/replace-text-white-900-to-inverse.mjs --apply",
		"codemod:safe-pass-1": "node scripts/codemods/safe-pass-1.mjs",
		"codemod:safe-pass-1:apply": "node scripts/codemods/safe-pass-1.mjs --apply",
		"report:compat-tokens": "node scripts/compat-tokens-inventory.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@types/node": "catalog:",
		"knip": "5.85.0",
		"turbo": "2.9.14",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.16.0",
	"engines": {
		"node": ">=24"
	},
	"pnpm": {
		"overrides": {
			"zod@>=4.0.0 <4.6.7": "4.6.7",
			"@giselles-ai/browser-tool>@modelcontextprotocol/sdk": "1.32.2",
			"@electric-sql/client@<1.0.10": "1.0.10",
			"cookie": "1.0.2",
			"@react-email/preview-server>next": "16.4.3",
			"@babel/helpers": "7.26.10",
			"@babel/runtime": "7.26.10",
			"vite": "7.3.7",
			"jws": "4.0.1",
			"glob@>=11.0.0 <11.1.0": "11.1.0",
			"fast-xml-parser": "5.7.3",
			"fast-uri": "3.1.9",
			"protobufjs": "7.6.5",
			"hono": "4.13.17",
			"@hono/node-server": "2.1.6",
			"ajv@>=6.0.0 <7.0.0": "6.14.0",
			"js-yaml@>=3.0.0 <4.0.0": "3.15.0",
			"js-yaml@>=4.0.0 <4.3.2": "4.3.2",
			"smol-toml@>=1.0.0 <1.7.1": "1.7.1",
			"@esbuild-kit/core-utils>esbuild": "0.28.1",
			"esbuild@>=0.17.0 <0.28.1": "0.28.1",
			"serialize-javascript": "7.0.5",
			"systeminformation": "5.33.16",
			"nanoid@>=3.0.0 <3.3.20": "3.3.20",
			"nanoid@>=5.0.0 <5.1.16": "5.1.16",
			"socket.io-parser": "4.2.7",
			"undici@>=7.0.0 <7.30.1": "7.30.1",
			"@xmldom/xmldom": "0.8.15",
			"path-to-regexp@>=8.0.0 <8.4.0": "8.4.2",
			"express-rate-limit": "8.2.2",
			"ip-address": "10.7.6",
			"picomatch@>=4.0.0 <4.0.4": "4.0.4",
			"picomatch@<2.3.2": "2.3.2",
			"yaml@>=2.0.0 <2.8.3": "2.8.3",
			"tmp@<0.2.7": "0.2.7",
			"brace-expansion@>=4.0.0 <5.0.11": "5.0.11",
			"browserslist@>=4.0.0 <4.28.7": "4.28.7",
			"body-parser@>=2.0.0 <2.4.0": "2.4.0",
			"engine.io@>=4.1.0 <6.6.10": "6.6.10",
			"linkify-it@<=5.0.1": "5.0.2",
			"postcss@<8.5.18": "8.5.23",
			"source-map-js@>=1.0.0 <1.2.2": "1.2.2",
			"uuid@<14.0.0": "14.0.0",
			"ws@>=8.0.0 <8.21.0": "8.21.0",
			"ws@>=7.0.0 <7.5.11": "7.5.11",
			"qs@>=6.11.1 <6.17.1": "6.17.1",
			"@babel/core@<=7.29.0": "7.29.7",
			"markdown-it@<14.3.3": "14.3.3",
			"prosemirror-view@>=1.0.0 <1.42.3": "1.42.3",
			"prosemirror-model@>=1.0.0 <1.25.8": "1.25.8",
			"@opentelemetry/core@<2.8.0": "2.8.0",
			"sharp@<0.35.0": "0.35.0",
			"tar@<7.5.21": "7.5.21"
		}
	}
}
