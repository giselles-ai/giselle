{
	"name": "@giselles-ai/text-editor-utils",
	"version": "0.0.0",
	"private": true,
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"scripts": {
		"build": "tsup",
		"check-types": "tsc --noEmit",
		"clean": "rm -rf .turbo dist node_modules",
		"format": "biome check --write .",
		"test": "vitest run"
	},
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"devDependencies": {
		"@giselles-ai/tsconfig": "workspace:*",
		"@types/turndown": "catalog:",
		"tsup": "catalog:",
		"vitest": "catalog:"
	},
	"dependencies": {
		"@giselles-ai/protocol": "workspace:*",
		"@tiptap/core": "catalog:",
		"@tiptap/react": "catalog:",
		"@tiptap/html": "catalog:",
		"@tiptap/starter-kit": "catalog:",
		"@tiptap/extension-code-block-lowlight": "catalog:",
		"highlight.js": "catalog:",
		"lowlight": "catalog:",
		"turndown": "catalog:"
	},
	"imports": {
		"#tiptap-html": {
			"node": "@tiptap/html/server",
			"default": "@tiptap/html"
		}
	}
}
